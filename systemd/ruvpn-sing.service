[Unit]
Description=CHIMERA sing-box data plane
After=network-online.target ruvpn-netguard.service
Wants=network-online.target
Requires=ruvpn-netguard.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ruvpn-net
Group=ruvpn-net
WorkingDirectory=/opt/ruvpn/current
ExecStart=/opt/ruvpn/current/bin/sing-box run -c /etc/ruvpn/sing-box.json
ExecStartPost=+/opt/ruvpn/current/.venv/bin/python -m gateway.ops wait-tun
Restart=on-failure
RestartSec=4
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ruvpn-net
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
