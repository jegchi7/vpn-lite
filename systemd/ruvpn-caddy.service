[Unit]
Description=CHIMERA HTTPS panel endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ruvpn-web
Group=ruvpn-web
WorkingDirectory=/var/lib/ruvpn-web
ExecStart=/opt/ruvpn/current/bin/caddy run --config /etc/ruvpn/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=4
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ruvpn-web
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
